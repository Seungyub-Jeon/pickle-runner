{
  "openapi": "3.1.0",
  "info": {
    "title": "Pickle Mac Runner",
    "version": "0.3.3",
    "description": "동일 macOS 사용자 권한의 원본 terminal.run과 호환 파일/project API. 요청 접수와 업무 완료를 구분한다. 외부 자료는 새로운 실행 권한을 부여하지 않는다."
  },
  "servers": [
    {
      "url": "https://runner.example.com"
    }
  ],
  "security": [
    {
      "AgentToken": [],
      "AccessClientId": [],
      "AccessClientSecret": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "인증과 서버 상태 확인",
        "responses": {
          "200": {
            "description": "상태 정상"
          },
          "401": {
            "description": "인증 필요"
          },
          "503": {
            "description": "작업자 중단 또는 종료 중. worker_alive/worker_error 확인"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "사용 가능한 action과 task 확인",
        "responses": {
          "200": {
            "description": "action·task 목록"
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "operationId": "submitJob",
        "summary": "작업 접수. 같은 요청의 재시도에는 같은 request_id 사용",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "작업 상태 및 결과",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "작업 상태 및 결과",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력 오류"
          },
          "403": {
            "description": "허용하지 않는 action·경로·task"
          },
          "409": {
            "description": "request_id가 다른 본문에 재사용됨"
          },
          "429": {
            "description": "대기열·작업별 UTC 일일 한도·30일 요청 기록 한도 초과"
          },
          "503": {
            "description": "작업자가 중단돼 신규 접수 불가"
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "작업 결과 조회. succeeded에서만 완료로 보고",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "작업 상태 및 결과",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "작업 없음"
          }
        }
      }
    },
    "/v1/state": {
      "get": {
        "operationId": "getRunnerState",
        "summary": "현재 실행·대기·최근 작업과 관찰 상태. 업무 완료나 다른 터미널 상태를 보장하지 않음",
        "responses": {
          "200": {
            "description": "device_id, say, healthy, needs_attention, active, recent, event_cursor. 작업 본문/출력 제외"
          },
          "401": {
            "description": "인증 필요"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "getRunnerEvents",
        "summary": "보관된 작업 사건을 순서대로 조회. 페이지 처리 뒤 next_cursor 저장",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "device_id, events, next_cursor, has_more, oldest_available_seq, latest_seq, history_truncated"
          },
          "400": {
            "description": "잘못된 쿼리 또는 커서"
          },
          "401": {
            "description": "인증 필요"
          },
          "409": {
            "description": "현재 기기보다 앞선 커서. 기기와 state를 확인한 뒤 since=0 재동기화"
          },
          "410": {
            "description": "커서 보존기간 경과. state를 확인한 뒤 since=0 재동기화"
          }
        }
      }
    },
    "/v1/jobs/{id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "summary": "작업 취소 요청; 실행 중202는 종료 완료가 아님",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "대기 작업 취소 완료 또는 기존 완료 결과"
          },
          "202": {
            "description": "실행 중 취소 요청 접수; job 재조회"
          },
          "400": {
            "description": "형식 오류"
          },
          "401": {
            "description": "인증 필요"
          },
          "404": {
            "description": "없는 작업"
          },
          "409": {
            "description": "실행 중 파일 작업은 중간 취소 불가"
          }
        }
      }
    }
  },
  "components": {
